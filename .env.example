# Application metadata
APP_NAME=Silver Enigma
APP_SUMMARY=B2B order management engine
APP_DESCRIPTION=State-driven fulfillment engine

# Backend configuration
DEBUG=True
ENVIRONMENT=development
BACKEND_PORT=8000
BACKEND_WORKERS=4

# Database configuration
DATABASE_URL=postgresql+psycopg2://postgres:password@postgres:5432/silver_enigma
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_DB=silver_enigma
POSTGRES_PASSWORD=password

# Redis configuration
REDIS_PORT=6379
REDIS_PASSWORD=password
REDIS_HOST=redis
REDIS_DB=0
